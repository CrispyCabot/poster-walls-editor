{
  "name": "poster-walls-editor",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "api", "app", "infrastructure"],
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc --build && tsc -p infrastructure/tsconfig.json --noEmit && tsc -p app/tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2"
  }
}
