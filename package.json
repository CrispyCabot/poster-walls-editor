{
  "name": "poster-walls-editor",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "api",
    "app",
    "infrastructure"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --build && tsc -p infrastructure/tsconfig.json --noEmit && tsc -p app/tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
